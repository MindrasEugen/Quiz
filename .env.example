# Copia questo file in .env e inserisci la chiave solo lì.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
AI_MODEL=mistral-medium-latest
# Per endpoint compatibili con Chat Completions:
# AI_PROVIDER=compatible
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=
# AI_MODEL=nome-modello
# Facoltativo: conserva i quiz in corso dopo riavvii e deploy (tabella AAA3_Quiz_sessions).
# Usa la chiave SEGRETA (sb_secret_...), mai quella pubblica. Senza queste righe le sessioni restano in memoria.
# SUPABASE_URL=https://wjswqerpvwockfbgjggy.supabase.co
# SUPABASE_SECRET_KEY=
PORT=3000
